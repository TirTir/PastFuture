# ============================================================
# Past, Future — .gitattributes 초안
# 근거: Handover v0.3 14.2 (일반 Git: .cs/.unity/.prefab/텍스트 .asset/.json/.md/
#       Packages/ProjectSettings/.meta, LFS: 대형 바이너리 선택 적용)
# ============================================================

# 기본: 텍스트 자동 감지 + 저장소 내부 LF 정규화
* text=auto

# --- 코드 / 문서 / 설정 (일반 Git) ---
*.cs        text diff=csharp
*.asmdef    text
*.asmref    text
*.json      text
*.md        text
*.txt       text
*.xml       text
*.yml       text
*.yaml      text
*.shader    text
*.hlsl      text
*.cginc     text
*.compute   text
*.uss       text
*.uxml      text
*.inputactions text

# --- Unity YAML (Force Text 직렬화, 일반 Git) ---
# UnityYAMLMerge(smart merge) 드라이버 연결은 별도 결정 사항 (git config 필요)
*.unity     text
*.prefab    text
*.asset     text
*.mat       text
*.anim      text
*.controller text
*.overrideController text
*.mask      text
*.physicMaterial text
*.physicsMaterial2D text
*.playable  text
*.signal    text
*.preset    text
*.lighting  text
*.meta      text

# Force Text 로도 바이너리로 저장되는 Unity 데이터
LightingData.asset filter=lfs diff=lfs merge=lfs -text
*.terrainlayer text

# --- Git LFS: 3D 모델 ---
*.fbx   filter=lfs diff=lfs merge=lfs -text
*.FBX   filter=lfs diff=lfs merge=lfs -text
